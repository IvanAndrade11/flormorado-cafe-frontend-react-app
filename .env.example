# Copia este archivo a .env.development y .env.production (ambos están en
# .gitignore) y completa los valores. Webpack los inyecta en el bundle, así que
# aquí solo va lo que es público en el navegador.

# Clave del SDK de ConfigCat (feature flags y catálogo).
SDK_CNFCT=

# Base de la API de pedidos. Sin ella se usa el Worker de producción; en local
# apúntala a http://localhost:8787 con el backend corriendo.
ORDERS_API_URL=

# Clave PÚBLICA del widget de Turnstile (Cloudflare → Turnstile). Sin ella el
# captcha no se muestra y las peticiones salen sin token. Para probar en local
# sirve la clave de prueba 1x00000000000000000000BB (siempre pasa), junto con
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA en el .dev.vars del
# backend.
TURNSTILE_SITE_KEY=
